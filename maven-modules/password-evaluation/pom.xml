<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>edu.asu.cse360.local</groupId>
        <artifactId>cse360-course-workspace</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>password-evaluation-testbed-f26</artifactId>

    <properties>
        <homework.source>${project.basedir}/../../CSE-360-Software-Engineering/HW1-linhmho/PasswordEvaluationTestbed-F26/src</homework.source>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${homework.source}</sourceDirectory>
        <resources>
            <resource>
                <directory>${homework.source}</directory>
                <excludes><exclude>**/*.java</exclude></excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.maven.plugin.version}</version>
                <configuration>
                    <mainClass>PasswordEvaluationTestbed/passwordEvaluationTestbedMain.PasswordEvaluationGUITestbed</mainClass>
                    <options><option>--enable-native-access=javafx.graphics</option></options>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
